# Brent Dec26 72 ATM call — recipes for this example book.
# Run from this directory (`just` finds the nearest justfile), or from the
# repo root via `just -f examples/brent-option/justfile <recipe>`.

qloxide := "../.."

# List available recipes
default:
    @just --list --unsorted

# All reports against the current book
book:
    cargo run --quiet --manifest-path {{qloxide}}/Cargo.toml --bin qloxide-book -- --config book.toml

# What-if: the full current book against one historical series day
# (includes deals struck later — not P&L history; that's `just series`)
day date:
    cargo run --quiet --manifest-path {{qloxide}}/Cargo.toml --bin qloxide-book -- \
        --config series/day-{{date}}.toml

# True P&L history over the committed series, in one invocation:
# composition-aware (deals count from inception), with daily changes
series:
    cargo run --quiet --manifest-path {{qloxide}}/Cargo.toml --bin qloxide-book -- \
        --config book.toml --report pnl-series

# Model-world risk: position greeks, calibration residuals (model vs
# settle), model book value
risk:
    cargo run --quiet --manifest-path {{qloxide}}/Cargo.toml --bin qloxide-risk -- \
        --config book.toml --report risk
