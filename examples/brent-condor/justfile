# Brent Sep26 iron condor — recipes for this example book.
# Run from this directory (`just` finds the nearest justfile), or from the
# repo root via `just -f examples/brent-condor/justfile <recipe>`.

qloxide := "../.."

# List available recipes
default:
    @just --list --unsorted

# All reports against the 2026-07-16 book
book:
    cargo run --quiet --manifest-path {{qloxide}}/Cargo.toml -- --config book.toml

# What-if: the full current book against one historical series day
# (includes deals struck later — not P&L history; that's `just series`)
day date:
    cargo run --quiet --manifest-path {{qloxide}}/Cargo.toml -- \
        --config series/day-{{date}}.toml

# True P&L history over the committed series, in one invocation:
# composition-aware (deals count from inception), with daily changes
series:
    cargo run --quiet --manifest-path {{qloxide}}/Cargo.toml -- \
        --config book.toml --report pnl-series

# What-if across every committed series day (the pre-3.5e loop): today's
# full book valued against each historical market
series-whatif:
    for f in series/day-*.toml; do \
        echo "== $(basename $f .toml)"; \
        cargo run --quiet --manifest-path {{qloxide}}/Cargo.toml -- \
            --config $f --report pnl | tail -3; \
    done
