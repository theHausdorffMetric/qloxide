# Brent Jul/Dec time spread — recipes for this example book.
# Run from this directory (`just` finds the nearest justfile).

qloxide := "../.."

# List available recipes
default:
    @just --list --unsorted

# All reports, valued at the last history day
book:
    cargo run --quiet --manifest-path {{qloxide}}/Cargo.toml --bin qloxide-book -- --config book.toml

# True P&L history from inception (2026-02-02): watch the Jul leg
# realize at its 2026-05-29 expiry, leaving the outright Dec short
series:
    cargo run --quiet --manifest-path {{qloxide}}/Cargo.toml --bin qloxide-book -- \
        --config book.toml --report pnl-series

# Model-world risk: futures deltas + model book value
risk:
    cargo run --quiet --manifest-path {{qloxide}}/Cargo.toml --bin qloxide-risk -- \
        --config risk.toml
